        { "value": "latent_defects", "ar": "ضمان العيوب الخفية", "en": "Warranty against latent defects" },
        { "value": "price_change_force_majeure", "ar": "بند تغير الأسعار والقوة القاهرة", "en": "Price change and force majeure clause" }
      ]
