      ]
    },
    {
      "id": "payment_terms", "src": ["F4"], "type": "checkbox", "ar": "شروط الدفع", "en": "Payment terms", "req": "review",
      "options": [
        { "value": "cash", "ar": "كاش", "en": "Cash" },
        { "value": "deferred", "ar": "آجل", "en": "Deferred" },
        { "value": "cheques", "ar": "شيكات", "en": "Cheques" }
      ]
    },
    { "id": "payment_terms_details", "src": ["F4"], "type": "textarea", "ar": "تفاصيل شروط الدفع", "en": "Payment terms details", "req": "review" },
