    { "id": "land_area", "src": ["F3"], "type": "text", "ar": "المساحة بالفدان والقيراط والسهم", "en": "Area in feddans, qirats and sahms", "req": "yes" },
    { "id": "possession_number", "src": ["F4"], "type": "text", "ar": "رقم الحيازة الزراعية", "en": "Agricultural possession number", "req": "review" }
  ],
  "financial": [
