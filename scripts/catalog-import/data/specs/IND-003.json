      "id": "payment_schedule", "src": ["F5"], "type": "repeater", "ar": "جدول السداد", "en": "Payment schedule", "req": "review", "maxItems": 48,
      "columns": [
        { "id": "due_date", "type": "date", "ar": "تاريخ الاستحقاق", "en": "Due date", "required": true },
        { "id": "amount", "type": "number", "ar": "المبلغ (ج.م)", "en": "Amount (EGP)", "required": true, "min": 0 }
      ]
    }
  ],
  "special": [
    {
      "id": "clauses", "src": ["G1", "G2", "G3"], "type": "checkbox", "ar": "الشروط الخاصة التي ترغب في تضمينها", "en": "Special terms you want included", "req": "no",
      "options": [
        { "value": "possession_transfer", "ar": "نقل الحيازة بالجمعية الزراعية", "en": "Transfer of possession at the agricultural cooperative" },
        { "value": "free_of_bank_debts", "ar": "خلو الأرض من ديون البنك الزراعي", "en": "Land free of Agricultural Bank debts" },
        { "value": "actual_handover", "ar": "التسليم الفعلي", "en": "Actual handover" }
      ]
    },
    { "id": "clause_details", "src": ["G1", "G2", "G3"], "type": "textarea", "ar": "تفاصيل أو ملاحظات على الشروط المختارة", "en": "Details or notes on the selected terms", "req": "no" }
  ],
  "documents": [
    { "id": "doc_party_ids", "src": ["H1"], "type": "file", "ar": "بطاقات الأطراف", "en": "ID cards of the parties", "req": "yes", "maxFiles": 4 },
    { "id": "doc_possession_card", "src": ["H2"], "type": "file", "ar": "بطاقة الحيازة الزراعية", "en": "Agricultural possession card", "req": "yes", "maxFiles": 2 },
    { "id": "doc_title_deed", "src": ["H3"], "type": "file", "ar": "سند الملكية", "en": "Title deed", "req": "yes", "maxFiles": 2 }
