  "documents": [
    { "id": "doc_ids_or_register", "src": ["H1"], "type": "file", "ar": "صور الهوية أو السجل التجاري", "en": "ID copies or commercial register", "req": "yes", "maxFiles": 4 },
    { "id": "doc_ad_script", "src": ["H2"], "type": "file", "ar": "سكريبت أو محاور الإعلان", "en": "Ad script or talking points", "req": "review", "maxFiles": 3 }
