    { "id": "stories_count", "src": ["F2"], "type": "number", "ar": "عدد الاستوريز", "en": "Number of stories", "req": "review", "min": 0 },
    { "id": "publishing_dates", "src": ["F3"], "type": "textarea", "ar": "مواعيد النشر", "en": "Publishing dates", "req": "review" }
  ],
  "financial": [
