        { "value": "youtube", "ar": "يوتيوب", "en": "YouTube" }
      ]
    },
    { "id": "platforms_other", "src": ["F1"], "type": "text", "ar": "منصات أخرى معلن عليها", "en": "Other advertising platforms", "req": "review" },
