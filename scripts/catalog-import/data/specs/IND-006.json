    { "id": "deposit_amount", "src": ["F6"], "type": "number", "ar": "مبلغ التأمين (ج.م)", "en": "Deposit amount (EGP)", "req": "review", "min": 0 },
    { "id": "annual_increase", "src": ["F7"], "type": "text", "ar": "الزيادة السنوية", "en": "Annual increase", "req": "review", "maxLength": 100 }
  ],
  "special": [
    {
      "id": "clauses", "src": ["G1", "G2"], "type": "checkbox", "ar": "الشروط الخاصة التي ترغب في تضمينها", "en": "Special terms you want included", "req": "no",
      "options": [
        { "value": "decor_approval", "ar": "الموافقة على تعديلات الديكور", "en": "Approval of decor modifications" },
        { "value": "licences_and_meter", "ar": "استخراج التراخيص والعداد التجاري", "en": "Obtaining the licences and the commercial meter" }
      ]
    },
    { "id": "clause_details", "src": ["G1", "G2"], "type": "textarea", "ar": "تفاصيل أو ملاحظات على الشروط المختارة", "en": "Details or notes on the selected terms", "req": "no" },
    { "id": "fitout_grace_period", "src": ["G3"], "type": "text", "ar": "فترة السماح للتجهيز", "en": "Grace period for fit-out", "req": "no", "maxLength": 100 },
    { "id": "termination_terms", "src": ["G4"], "type": "textarea", "ar": "شروط الفسخ", "en": "Termination conditions", "req": "no" }
  ],
  "documents": [
    { "id": "doc_party_ids", "src": ["H1"], "type": "file", "ar": "صور البطاقات", "en": "ID card copies", "req": "yes", "maxFiles": 4 },
    { "id": "doc_register_and_tax_card", "src": ["H2"], "type": "file", "ar": "السجل التجاري والبطاقة الضريبية", "en": "Commercial register and tax card", "req": "no", "maxFiles": 4 }
