    { "id": "shop_area", "src": ["F2"], "type": "number", "ar": "المساحة (م²)", "en": "Area (m²)", "req": "review", "min": 1 },
    { "id": "permitted_activity", "src": ["F3"], "type": "text", "ar": "نوع النشاط التجاري المصرح به", "en": "Type of permitted commercial activity", "req": "yes" },
