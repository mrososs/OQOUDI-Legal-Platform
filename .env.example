# Supabase (local: run `npm run db:start` and copy the printed values)
SUPABASE_URL=http://127.0.0.1:55321
# Publishable / anon key — public by design, protected by RLS
SUPABASE_KEY=
# Secret / service-role key — SERVER ONLY, never exposed to the browser
SUPABASE_SECRET_KEY=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: `simulator` (development only, refused in production) | `paymob`
PAYMENTS_PROVIDER=simulator
# HMAC secret for simulator webhooks (any random 32+ byte hex string)
PAYMENTS_SIMULATOR_SECRET=

# Paymob (blocked: credentials not provided yet)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
