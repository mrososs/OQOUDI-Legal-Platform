# Supabase (local: run `npm run db:start` and copy the printed values)
SUPABASE_URL=http://127.0.0.1:55321
# Publishable / anon key — public by design, protected by RLS
SUPABASE_KEY=
# Secret / service-role key — SERVER ONLY, never exposed to the browser
SUPABASE_SECRET_KEY=

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: manual transfer verification (InstaPay / Vodafone Cash / PayPal).
# `manual_demo` (default) labels every submission and approval as a demo and
# keeps it out of revenue. Any unknown value falls back to `manual_demo`.
PAYMENT_MODE=manual_demo
# `manual_live` is honoured ONLY together with this exact acknowledgement,
# set after the separate go-live review (docs/payments/manual-payment-implementation.md).
PAYMENT_LIVE_ACKNOWLEDGED=
